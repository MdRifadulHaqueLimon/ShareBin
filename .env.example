# Upstash Redis (free tier) -> console.upstash.com -> your DB -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any long random string (32+ chars). Used for AES-256-GCM and IP hashing.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=

# Cloudflare R2 -> dashboard -> R2 -> your bucket + "Manage R2 API Tokens" (Object Read & Write)
# Without these, ShareBin still works but files are limited to 700 KB (stored inline in Redis).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: only for EU / FedRAMP jurisdiction buckets, e.g. <account>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT_HOST=
